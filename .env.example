# Copie para .env e preencha. Variáveis do ambiente têm prioridade sobre este arquivo.

# Token da brapi (https://brapi.dev), usado só para a lista de ações da B3.
BRAPI_TOKEN=

# Telegram (opcional, só no servidor local): token do bot criado no @BotFather. O chat de quem recebe
# se informa na aba Configurações (com botão de teste); TELEGRAM_CHAT_ID é um destino extra opcional.
# Na versão publicada o token é o segredo TELEGRAM_BOT_TOKEN do Worker.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Opcionais (valores padrão abaixo).
# MARKETPRESSURE_HOST=127.0.0.1
# MARKETPRESSURE_PORT=8765
# MARKETPRESSURE_DATA_DIR=data
# MARKETPRESSURE_LOG_LEVEL=INFO
